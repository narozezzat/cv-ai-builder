# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# Only the Supabase block is required to boot the app. Everything below it
# feature-flags itself off when absent: no AI provider key disables the AI suite,
# no OAuth credentials hide the social sign-in buttons.

# ── Supabase (required) ───────────────────────────────────────────────────────
# `pnpm db:start` prints these for the local stack. Run `supabase status` to see
# them again. The anon key is public by design — it carries the `anon` role and
# every table it reaches is gated by RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS. Server-only, used for writes the user must not be able to forge
# (AI usage metering, audit logs). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
# Canonical origin for metadata, sitemap, OAuth redirects, and share links.
# Falls back to VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the short-lived tokens the PDF renderer accepts, so /print/[token] is
# not an open render endpoint. Generate with: openssl rand -hex 32
EXPORT_TOKEN_SECRET=

# ── AI (needed from Phase 3) ──────────────────────────────────────────────────
# `google` | `openai` | `anthropic`. Google is the default because it is the only
# one of the three with a usable free tier: a key from
# https://aistudio.google.com/apikey needs no card and its per-minute/per-day
# quota covers a single developer and a demo. OpenAI has no free tier at all —
# a key without prepaid credit returns 429 `insufficient_quota` on every call,
# which reads like a rate limit and is not one.
#
# Only the key for the selected provider needs a value. The AI suite
# feature-flags itself off when that key is missing.
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model overrides, one per tier — leave blank to use the defaults in
# services/ai/provider.ts. Set these to retire or upgrade a model without a deploy;
# the id must belong to the provider selected above.
AI_MODEL_FAST=
AI_MODEL_QUALITY=

# ── Social sign-in (optional) ─────────────────────────────────────────────────
# Also needs the matching provider enabled in supabase/config.toml.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
